<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not rewrite requests that are already inside Laravel's public directory.
    RewriteRule ^public/ - [L]

    # Serve all web requests through Laravel's public directory.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

Options -Indexes
